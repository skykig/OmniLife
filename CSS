*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#000;
height:100vh;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden;
color:#fff;
}

.background{
position:fixed;
width:100%;
height:100%;
background:
radial-gradient(circle at center,#0b1b40 0%,#000 70%);
z-index:-1;
}

.container{
text-align:center;
}

.orb{
width:190px;
height:190px;
margin:auto;
border-radius:50%;
background:radial-gradient(circle,#8bd3ff,#2563eb,#00142b);
box-shadow:
0 0 30px #3b82f6,
0 0 80px #2563eb,
0 0 140px #1d4ed8;
animation:pulse 3s infinite ease-in-out;
}

@keyframes pulse{

0%{
transform:scale(1);
}

50%{
transform:scale(1.12);
}

100%{
transform:scale(1);
}

}

h1{
margin-top:40px;
font-size:42px;
}

p{
margin-top:12px;
font-size:18px;
color:#9ec9ff;
}

button{

margin-top:40px;
padding:16px 40px;
font-size:18px;
border:none;
border-radius:50px;
background:#2563eb;
color:white;
cursor:pointer;
transition:.4s;

}

button:hover{

background:#3b82f6;
transform:scale(1.05);

}
